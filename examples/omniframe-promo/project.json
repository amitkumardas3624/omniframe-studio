        {
          "id": "inspect",
          "name": "Compose and inspect",
          "kind": "code_scene",
          "start_frame": 630,
          "duration_frames": 150,
          "code": {
            "html": "<div id='scene'><div class='label'>DELIVERY / 04</div><div id='preview'><div class='mini'>OMNI<br>FRAME</div><div class='mini'>RENDER<br>READY</div><div class='mini'>FINAL<br>PREVIEW</div></div><div id='progress'><span></span></div><div id='message'>Composing H.264 + AAC delivery</div><div id='ok'>✓ INSPECTED</div></div>",
            "css": "html,body,#scene{margin:0;width:1920px;height:1080px;overflow:hidden;background:#070B16;color:#F2F6FF;font-family:Inter,Arial,sans-serif}#scene{position:relative}.label{position:absolute;left:150px;top:130px;color:#9B7BFF;font-size:22px;letter-spacing:5px}#preview{position:absolute;left:150px;top:270px;display:flex;gap:28px}.mini{width:280px;height:170px;border:1px solid #465779;border-radius:12px;background:linear-gradient(145deg,#16233D,#0B1122);display:flex;align-items:center;justify-content:center;text-align:center;color:#56E0FF;font-size:25px;font-weight:800}#progress{position:absolute;left:150px;top:550px;width:1050px;height:12px;background:#202D47;border-radius:10px;overflow:hidden}#progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#56E0FF,#9B7BFF)}#message{position:absolute;left:150px;top:610px;color:#8FA3C8;font:24px Consolas,monospace}#ok{position:absolute;left:1500px;top:600px;color:#56E0FF;font-size:30px;font-weight:800}",
            "javascript": "const t=__OMNIFRAME_FRAME__/Math.max(1,__OMNIFRAME_TOTAL_FRAMES__-1); document.querySelector('#progress span').style.width=`${Math.min(1,t*1.3)*1050}px`; document.querySelectorAll('.mini').forEach((el,i)=>el.style.transform=`translateY(${(1-Math.min(1,t*2))*35*(i+1)}px)`); document.getElementById('ok').style.opacity=String(Math.max(0,Math.min(1,(t-.6)*4)));",
            "seed": 31,
            "background": "#070B16",
            "params": {"scene": "inspect"},
            "settle_timeout_ms": 120
          }
        },
        {
          "id": "cta",
          "name": "Call to action",
          "kind": "code_scene",
          "start_frame": 780,
          "duration_frames": 120,
          "code": {
            "html": "<div id='scene'><div id='mark'>◈</div><div id='title'>Describe it. Render it. Ship it.</div><div id='brand'>OmniFrame Studio</div><div id='rule'></div><div id='sub'>AI agents to final video.</div></div>",
            "css": "html,body,#scene{margin:0;width:1920px;height:1080px;overflow:hidden;background:#070B16;color:#F2F6FF;font-family:Inter,Arial,sans-serif}#scene{position:relative;text-align:center}#mark{position:absolute;left:880px;top:170px;color:#56E0FF;font-size:120px;text-shadow:0 0 60px #56E0FF88}#title{position:absolute;left:0;right:0;top:390px;font-size:72px;font-weight:800;letter-spacing:-2px}#brand{position:absolute;left:0;right:0;top:550px;color:#56E0FF;font-size:30px;letter-spacing:7px;font-weight:800}#rule{position:absolute;left:620px;top:635px;width:680px;height:3px;background:linear-gradient(90deg,transparent,#56E0FF,#9B7BFF,transparent)}#sub{position:absolute;left:0;right:0;top:700px;color:#8FA3C8;font-size:25px}",
            "javascript": "const t=__OMNIFRAME_FRAME__/Math.max(1,__OMNIFRAME_TOTAL_FRAMES__-1); const e=1-Math.pow(1-t,3); document.getElementById('mark').style.transform=`scale(${.5+e*.5}) rotate(${e*90}deg)`; document.getElementById('title').style.opacity=String(Math.min(1,t*3)); document.getElementById('brand').style.opacity=String(Math.max(0,Math.min(1,(t-.25)*3))); document.getElementById('sub').style.opacity=String(Math.max(0,Math.min(1,(t-.45)*3)));",
            "seed": 37,
