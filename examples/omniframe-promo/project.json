        {
          "id": "hook",
          "name": "Hook",
          "kind": "code_scene",
          "start_frame": 0,
          "duration_frames": 90,
          "code": {
            "html": "<div id='scene'><div id='pulse'></div><div id='eyebrow'>OMNIFRAME STUDIO</div><div id='title'>What if your AI agent<br>could ship the video?</div><div id='line'></div></div>",
            "css": "html,body,#scene{margin:0;width:1920px;height:1080px;overflow:hidden;background:#070B16;color:#F2F6FF;font-family:Inter,Arial,sans-serif}#scene{position:relative}#pulse{position:absolute;left:960px;top:420px;width:180px;height:180px;border:3px solid #56E0FF;border-radius:50%;box-shadow:0 0 80px #56E0FF66}#eyebrow{position:absolute;left:180px;top:210px;color:#56E0FF;font-size:24px;letter-spacing:8px;font-weight:700}#title{position:absolute;left:176px;top:290px;font-size:82px;line-height:1.03;font-weight:800;letter-spacing:-3px}#line{position:absolute;left:180px;top:540px;height:4px;width:420px;background:linear-gradient(90deg,#56E0FF,#9B7BFF);border-radius:4px}",
            "javascript": "const t=__OMNIFRAME_FRAME__/Math.max(1,__OMNIFRAME_TOTAL_FRAMES__-1); const ease=1-Math.pow(1-t,3); const pulse=document.getElementById('pulse'); pulse.style.transform=`translate(-50%,-50%) scale(${0.25+ease*2.2})`; pulse.style.opacity=String(Math.min(1,t*3)); document.getElementById('title').style.opacity=String(Math.min(1,t*4)); document.getElementById('title').style.transform=`translateY(${(1-Math.min(1,t*4))*28}px)`; document.getElementById('line').style.width=`${420+ease*620}px`;",
            "seed": 17,
            "background": "#070B16",
            "params": {"scene": "hook"},
            "settle_timeout_ms": 120
          }
        },
        {
          "id": "prompt",
          "name": "Agent prompt",
          "kind": "code_scene",
          "start_frame": 90,
          "duration_frames": 150,
          "code": {
            "html": "<div id='scene'><div class='label'>AGENT REQUEST / 01</div><div id='terminal'><div class='top'><i></i><i></i><i></i><span>omniframe-agent</span></div><div id='copy'></div><div id='cursor'></div><div class='status'>● REQUEST ACCEPTED <b>signal-to-cinema</b></div></div><div class='side'>INPUT<br><strong>Natural language</strong><br><br>OUTPUT<br><strong>Production-ready</strong></div></div>",
            "css": "html,body,#scene{margin:0;width:1920px;height:1080px;overflow:hidden;background:#070B16;color:#EAF2FF;font-family:Inter,Arial,sans-serif}#scene{position:relative}.label{position:absolute;left:160px;top:150px;color:#56E0FF;font-size:22px;letter-spacing:5px}.top{height:68px;padding:0 28px;display:flex;align-items:center;gap:10px;color:#8FA3C8;border-bottom:1px solid #33415F}.top i{width:12px;height:12px;border-radius:50%;background:#56E0FF}.top i:nth-child(2){background:#9B7BFF}.top i:nth-child(3){background:#A1B4D5}.top span{margin-left:16px}.terminal{position:absolute;left:160px;top:230px;width:1250px;height:530px;border:1px solid #3A4A6B;border-radius:20px;background:#0D1528;box-shadow:0 30px 100px #0008}.terminal>*{margin-left:32px}.status{position:absolute;left:0;bottom:30px;color:#56E0FF}.status b{color:#F2F6FF;margin-left:12px}.side{position:absolute;left:1500px;top:310px;color:#7D91B9;line-height:1.5;font-size:20px}.side strong{color:#F2F6FF;font-size:28px}",
            "javascript": "const t=__OMNIFRAME_FRAME__/Math.max(1,__OMNIFRAME_TOTAL_FRAMES__-1); const text='Create a polished product scene from this idea.'; const shown=Math.floor(Math.min(1,t*1.8)*text.length); document.getElementById('copy').textContent='> '+text.slice(0,shown); document.getElementById('cursor').style.display=(Math.floor(t*12)%2?'none':'block'); document.getElementById('cursor').style.cssText+=';width:12px;height:28px;background:#56E0FF;display:inline-block;vertical-align:middle;margin-left:8px;';",
            "seed": 19,
            "background": "#070B16",
            "params": {"scene": "prompt"},
            "settle_timeout_ms": 120
          }
        },
        {
          "id": "structure",
          "name": "Timeline and validation",
          "kind": "code_scene",
          "start_frame": 240,
          "duration_frames": 180,
          "code": {
            "html": "<div id='scene'><div class='label'>STRUCTURE / 02</div><div id='timeline'><div class='track'><b>CODE SCENE</b><span></span></div><div class='track'><b>2D MOTION</b><span></span></div><div class='track'><b>AUDIO</b><span></span></div></div><div id='checks'><div>✓ schema validated</div><div>✓ checkpoint created</div><div>✓ tools routed</div></div><div id='badge'>READY TO RENDER</div></div>",
            "css": "html,body,#scene{margin:0;width:1920px;height:1080px;overflow:hidden;background:#070B16;color:#F2F6FF;font-family:Inter,Arial,sans-serif}#scene{position:relative}.label{position:absolute;left:150px;top:130px;color:#9B7BFF;font-size:22px;letter-spacing:5px}#timeline{position:absolute;left:150px;top:260px;width:1200px}.track{height:84px;border-bottom:1px solid #33415F;display:flex;align-items:center;gap:36px;color:#8FA3C8}.track b{width:170px;color:#F2F6FF;font-size:20px}.track span{height:34px;width:0;border-radius:8px;background:linear-gradient(90deg,#56E0FF,#9B7BFF)}#checks{position:absolute;left:1500px;top:290px;color:#56E0FF;font-size:22px;line-height:2.3}#badge{position:absolute;left:150px;top:640px;color:#07111E;background:#56E0FF;padding:18px 28px;border-radius:9px;font-size:22px;font-weight:800;letter-spacing:2px}",
            "javascript": "const t=__OMNIFRAME_FRAME__/Math.max(1,__OMNIFRAME_TOTAL_FRAMES__-1); document.querySelectorAll('.track span').forEach((el,i)=>el.style.width=`${Math.max(0,Math.min(1,t*1.6-i*.22))*760}px`); document.getElementById('checks').style.opacity=String(Math.max(0,Math.min(1,(t-.35)*3))); document.getElementById('badge').style.transform=`translateX(${(1-Math.min(1,t*2))*-30}px)`;",
            "seed": 23,
            "background": "#070B16",
            "params": {"scene": "structure"},
            "settle_timeout_ms": 120
          }
