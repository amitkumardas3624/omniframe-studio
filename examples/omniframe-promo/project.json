        {
          "id": "render",
          "name": "Render code and motion",
          "kind": "code_scene",
          "start_frame": 420,
          "duration_frames": 210,
          "code": {
            "html": "<div id='scene'><div class='label'>RENDER / 03</div><div id='left'><div class='bar'></div><div class='code'>const scene = await<br>agent.render({<br>&nbsp;&nbsp;engine: 'code_video',<br>&nbsp;&nbsp;frames: 210<br>});</div></div><div id='right'><div class='orb'></div><div class='ring'></div><div class='nodes'>● · · ● · · ●</div></div><div id='counter'>FRAME 000 / 210</div></div>",
            "css": "html,body,#scene{margin:0;width:1920px;height:1080px;overflow:hidden;background:#070B16;color:#F2F6FF;font-family:Inter,Arial,sans-serif}#scene{position:relative}.label{position:absolute;left:150px;top:120px;color:#56E0FF;font-size:22px;letter-spacing:5px}#left,#right{position:absolute;top:240px;width:720px;height:500px;border:1px solid #3A4A6B;border-radius:18px;background:#0D1528;overflow:hidden}.left{left:150px}.right{left:1050px}.bar{height:8px;background:linear-gradient(90deg,#56E0FF,#9B7BFF);width:0}.code{padding:56px;color:#AFC2E8;font:28px/1.65 Consolas,monospace}.orb{position:absolute;left:260px;top:140px;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#F2F6FF,#56E0FF 18%,#9B7BFF 55%,#171C45 70%);box-shadow:0 0 90px #56E0FF88}.ring{position:absolute;left:205px;top:85px;width:270px;height:270px;border:2px solid #56E0FF88;border-radius:50%}.nodes{position:absolute;left:160px;top:390px;color:#56E0FF;letter-spacing:24px;font-size:26px}#counter{position:absolute;left:150px;top:800px;color:#8FA3C8;font:20px Consolas,monospace}",
            "javascript": "const t=__OMNIFRAME_FRAME__/Math.max(1,__OMNIFRAME_TOTAL_FRAMES__-1); const progress=Math.min(1,t*1.3); document.querySelector('.bar').style.width=`${progress*720}px`; document.querySelector('.orb').style.transform=`scale(${.75+progress*.35}) rotate(${progress*180}deg)`; document.querySelector('.ring').style.transform=`rotate(${progress*-220}deg) scale(${.8+progress*.25})`; document.getElementById('counter').textContent='FRAME '+String(Math.floor(progress*210)).padStart(3,'0')+' / 210';",
            "seed": 29,
            "background": "#070B16",
            "params": {"scene": "render"},
            "settle_timeout_ms": 120
