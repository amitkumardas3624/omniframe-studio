            "css": "",
            "javascript": "const t = __OMNIFRAME_FRAME__ / (__OMNIFRAME_TOTAL_FRAMES__ - 1);\nconst eased = 1 - Math.pow(1 - t, 3);\nconst bar = document.getElementById('bar');\nbar.style.width = (1040 * eased) + 'px';\nconst dot = document.getElementById('dot');\ndot.style.left = (116 + 1040 * eased) + 'px';\nconst title = document.getElementById('title');\ntitle.style.opacity = Math.min(1, t * 4);\ntitle.style.transform = 'translateY(' + ((1 - Math.min(1, t * 4)) * 24) + 'px)';\nconst sub = document.getElementById('sub');\nsub.textContent = t > 0.55 ? 'Deterministic frames. Exact timing.' : 'Code-driven motion graphics.';\nsub.style.opacity = Math.max(0, Math.min(1, (t - 0.25) * 4));",
