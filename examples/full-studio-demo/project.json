            "html": "<html><body style=\"margin:0;background:#05060c;font-family:system-ui,sans-serif\"><div id=\"stage\" style=\"position:relative;width:1280px;height:720px;overflow:hidden\"><div id=\"bar\" style=\"position:absolute;left:100px;top:300px;height:10px;width:0;background:linear-gradient(90deg,#5ad,#a6f);border-radius:5px\"></div><div id=\"title\" style=\"position:absolute;left:80px;top:200px;color:#eef;font-size:48px;font-weight:800;letter-spacing:-1px\">OmniFrame Studio</div><div id=\"sub\" style=\"position:absolute;left:100px;top:280px;color:#8fa3c8;font-size:20px\"></div></div></body></html>",
            "css": "",
            "javascript": "const t = __OMNIFRAME_FRAME__ / (__OMNIFRAME_TOTAL_FRAMES__ - 1);\nconst eased = 1 - Math.pow(1 - t, 3);\nconst bar = document.getElementById('bar');\nbar.style.width = (800 * eased) + 'px';\nconst title = document.getElementById('title');\ntitle.style.opacity = Math.min(1, t * 3);\ntitle.style.transform = 'translateY(' + ((1 - Math.min(1, t * 3)) * 16) + 'px)';\nconst sub = document.getElementById('sub');\nsub.textContent = t > 0.5 ? 'Code-driven motion graphics active' : 'Initializing...';\nsub.style.opacity = Math.max(0, Math.min(1, (t - 0.2) * 5));",
